# App
NODE_ENV=development
APP_NAME=UrlShortener
PORT=3001
CORS_ORIGINS=http://localhost:3000
SHORT_BASE_URL=http://localhost:3001

# PostgreSQL
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=url_shortener

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_ACCESS_SECRET=replace-with-access-secret
JWT_REFRESH_SECRET=replace-with-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
ISSUER=url-shortener
AUDIENCE=url-shortener-client
CLOCK_TOLERANCE_SEC=15

# 2FA / Encryption
TWOFA_TOKEN_SECRET=replace-with-twofa-token-secret
TWOFA_ENCRYPTION_KEY=replace-with-64-hex-chars

# Email (SMTP)
EMAIL_USER=your-email@example.com
EMAIL_PASSWORD=your-email-app-password
